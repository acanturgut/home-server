{
  "expo": {
    "name": "Home Voice",
    "slug": "home-voice",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "homevoice",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.canturgut.homevoice",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Lets you talk to your home assistant.",
        "NSSpeechRecognitionUsageDescription": "Used to convert your speech into text so the assistant can answer.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.canturgut.homevoice",
      "permissions": ["RECORD_AUDIO", "INTERNET"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lets you talk to your home assistant.",
          "speechRecognitionPermission": "Used to convert your speech into text."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
